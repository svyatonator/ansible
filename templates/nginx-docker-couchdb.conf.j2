server {
    listen 80;
    listen [::]:80;
    server_name {{ couchdb_domain }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ letsencrypt_webroot }};
        default_type "text/plain";
    }

{% if couchdb_nginx_enable_tls | default(false) %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    location / {
        return 404;
    }
{% endif %}
}

{% if couchdb_nginx_enable_tls | default(false) %}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ couchdb_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ couchdb_certbot_cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ couchdb_certbot_cert_name }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 100m;
    proxy_http_version 1.1;
    proxy_redirect off;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    location / {
        proxy_pass http://{{ couchdb_backend_host }}:{{ couchdb_backend_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl on;
    }
}
{% endif %}
